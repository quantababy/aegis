# ========================================================
# AEGIS AI Red-Team & Defense — Environment Configuration
# ========================================================
# IMPORTANT: Copy this file to '.env' and populate your secrets.
# NEVER commit the actual '.env' file containing private keys to git!

# --------------------------------------------------------
# 1. Commercial AI Provider Credentials (Optional)
# --------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --------------------------------------------------------
# 2. Local Ollama GPU Engine
# --------------------------------------------------------
# When running inside Docker, use the host gateway bridge:
OLLAMA_HOST=http://host.docker.internal:11434
# When running locally without Docker:
# OLLAMA_HOST=http://localhost:11434

# --------------------------------------------------------
# 3. Web3 & Blockchain Immutability Ledger (Sepolia Testnet)
# --------------------------------------------------------
# RPC endpoint (Alchemy, Infura, or public Sepolia node)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# STRICT SECURITY NOTICE:
# Use a dedicated, zero-balance or testnet-only developer wallet.
# NEVER supply a mainnet wallet private key!
PRIVATE_KEY=

# --------------------------------------------------------
# 4. Container Resource Limits & Port Bindings
# --------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=
